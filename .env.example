# Copy to .env and adjust.
# Image version to run. Leave it unset to run the newest loaded image
# (homeassistant:latest). Set it to an older tag, for example a49033b, only
# to go back to that version.
#TAG=
# Port on krpi that the dashboard and API listen on.
PORT=8080
# Directory for the SQLite file. On krpi, use a folder on the USB stick.
DATA_DIR=./data
