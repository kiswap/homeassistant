# Copy to .env and adjust.
# Image version to run: the tag that tools/build-image.sh printed, for
# example a49033b. To go back to an older version, set its tag again.
TAG=
# Port on krpi that the dashboard and API listen on.
PORT=8080
# Directory for the SQLite file. On krpi, use a folder on the USB stick.
DATA_DIR=./data
