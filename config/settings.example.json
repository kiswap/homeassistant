{
  "refresh_seconds": 60,
  "plugins": {
    "thermobeacon": {
      "api_key": "CHANGE_ME",
      "db_path": "/data/thermobeacon.sqlite",
      "stale_after_seconds": 600,
      "sensors": [
        {"id": "utazo",  "name": "utazó",  "icon": "room",    "address": "70:F7:00:00:12:DC"},
        {"id": "konyha", "name": "konyha", "icon": "kitchen", "address": "70:F7:00:00:14:63"},
        {"id": "kinti",  "name": "kinti",  "icon": "tree",    "address": "70:F7:00:00:12:3A"}
      ]
    },
    "weather": {
      "place": "Budapest",
      "latitude": 47.4979,
      "longitude": 19.0402,
      "radius_km": 50,
      "timezone": "Europe/Budapest",
      "cache_dir": "/data/weather"
    }
  },
  "layout": {
    "columns": 4,
    "rows": ["1.25fr", "1fr", "1fr", "1.15fr"],
    "widgets": [
      {"type": "thermobeacon.sensor", "sensor": "konyha", "col": 1, "row": 1},
      {"type": "thermobeacon.sensor", "sensor": "kinti",  "col": 2, "row": 1},
      {"type": "weather.radar", "col": 3, "row": 1, "colSpan": 2, "rowSpan": 3},
      {"type": "thermobeacon.graph", "sensors": ["konyha", "kinti"], "col": 1, "row": 2, "colSpan": 2, "rowSpan": 3},
      {"type": "weather.forecast", "col": 3, "row": 4, "colSpan": 2}
    ]
  }
}
